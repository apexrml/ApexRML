# Copy this file to ".env" and fill in your real values.
# Get these from https://developer.ebay.com/join -> Application Keys
# Use the PRODUCTION keyset once your account is approved (not Sandbox).

EBAY_CLIENT_ID=your_app_id_here
EBAY_CLIENT_SECRET=your_cert_id_here

# Marketplace to search. EBAY_GB = eBay UK. Full list:
# https://developer.ebay.com/api-docs/static/rest-request-components.html#marketpl
EBAY_MARKETPLACE=EBAY_GB

# --- Awin-network retailers (Euro Car Parts, GSF Car Parts, etc.) ---
# You need to be an APPROVED Awin affiliate for each merchant first:
# https://ui.awin.com -> apply to "Euro Car Parts" -> once approved,
# go to Datafeeds and copy the CSV download URL for their product feed.
#
# This is a JSON list. Leave it as [] (or delete the line) to search
# eBay only. Add one object per retailer once you have real feed URLs.
# "columns" is optional — only needed if a merchant's feed uses different
# column names than the Awin default (see providers/awin_feed.py for the
# defaults, and check the feed's own header row if results come back empty).
#
# Example once you have a real feed:
# AWIN_FEEDS=[{"name": "Euro Car Parts", "url": "https://productdata.awin.com/datafeed/download/apikey/XXXX/language/en/cid/XXXX/version/csv"}]
AWIN_FEEDS=[]
